# Equation Explainer configuration. The app re-reads this file on every request.
# LLM_PROVIDER: lmstudio | openrouter
LLM_PROVIDER=lmstudio

# --- LM Studio (local, OpenAI-compatible server) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# blank = whichever model LM Studio has loaded
LMSTUDIO_MODEL=
# more models for the top-right menu (comma-separated)
# LMSTUDIO_MODELS=qwen/qwen3-30b-a3b

# --- OpenRouter ---
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-fable-5.1
# OPENROUTER_MODELS=openai/gpt-5.6-sol-pro,qwen/qwen3-coder-30b-a3b-instruct

# --- level-set: the holistic learner profile (runs on each new board and from the level-set button) ---
# Uses OPENROUTER_API_KEY above. Set LEVELSET_PROVIDER=lmstudio to run it locally instead.
# LEVELSET_PROVIDER=openrouter        (default)
# LEVELSET_MODEL=openai/gpt-5.6-sol-pro (default)
# LEVELSET_MAX_TOKENS=32000
# LEVELSET_EXTRA_BODY={"reasoning":{"effort":"high"}}

# --- diagrams: circuits and architectures, drawn wherever an answer needs one ---
# Uses OPENROUTER_API_KEY above; without it, answers come without diagrams. DIAGRAM_PROVIDER=lmstudio draws them locally.
# DIAGRAM_PROVIDER=openrouter                     (default)
# DIAGRAM_MODEL=qwen/qwen3-coder-30b-a3b-instruct (default)
# DIAGRAM_TEMPERATURE=0.2
# DIAGRAM_MAX_TOKENS=4096

# --- generation ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192

# --- python (blank = managed environment: ~/Library/Application Support/EquationExplainer/pyenv on macOS,
#            ~/.local/share/EquationExplainer/pyenv on Linux) ---
# PYTHON_PATH=/path/to/python3
PYTHON_PACKAGES=numpy sympy scipy matplotlib
PYTHON_TIMEOUT=120
